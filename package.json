{
  "name": "chaosclip",
  "version": "1.11.0",
  "description": "Créer des GIF/WebP/MP4/WebM précis à partir de vidéos locales ou en ligne",
  "author": "DevLuho",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/DevLuho/ChaosClip.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --win",
    "apk": "cd android && .\\gradlew.bat assembleRelease && gh release upload v%npm_package_version% app/build/outputs/apk/release/ChaosClip-%npm_package_version%-arm64-v8a-release.apk --clobber",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "express": "^4.22.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gifsicle": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fr.devluho.chaosclip",
    "productName": "ChaosClip",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "lib/**",
      "public/**",
      "electron/**",
      "build/icon.png",
      "package.json",
      "!node_modules/gifsicle/vendor/source/**",
      "!node_modules/ffmpeg-static/**",
      "!node_modules/ffprobe-static/**"
    ],
    "beforePack": "build/ffmpeg.js",
    "asarUnpack": [
      "node_modules/gifsicle/vendor/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "vendor/ffmpeg",
          "to": "ffmpeg",
          "filter": ["*.exe", "*.dll", "LICENSE"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ChaosClip",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DevLuho",
        "repo": "ChaosClip",
        "releaseType": "draft"
      }
    ]
  }
}
